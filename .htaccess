# Root .htaccess — docroot is public/, so this file is not served via web.
# Kept minimal; real rewrite/security lives in public/.htaccess.
# error_log path unified to BASE_PATH/logs/php_errors.log (see config/init.php:35)
php_flag log_errors on
php_value error_log /home/kuplyuta/appliances/logs/php_errors.log
# Note: apps should log to BASE_PATH/logs/php_errors.log; this path kept for BC with old deploy.
